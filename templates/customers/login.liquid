<section class="section-spacing" aria-label="Customer Login">
  <div class="container" style="max-width: 520px; margin: 0 auto;">
    <div id="CustomerLoginForm" style="background: #FFFFFF; border: 1px solid var(--color-border); border-radius: 4px; padding: 2.5rem;">
      <span class="section-eyebrow" style="text-align: center; display: block;">Welcome Back</span>
      <h1 style="font-size: 2.2rem; text-align: center; margin-bottom: 2rem;">Customer Login</h1>

      {% form 'customer_login' %}
        {%- if form.errors -%}
          <div style="background: rgba(142, 58, 43, 0.1); border: 1px solid var(--color-sale); color: var(--color-sale); padding: 1rem; border-radius: 4px; margin-bottom: 1.5rem; font-size: 0.88rem;">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          <div>
            <label for="CustomerEmail" style="display: block; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; margin-bottom: 0.4rem;">
              Email Address
            </label>
            <input
              type="email"
              name="customer[email]"
              id="CustomerEmail"
              autocomplete="email"
              required
              style="width: 100%; padding: 0.85rem; border: 1px solid var(--color-border); border-radius: 2px;"
            >
          </div>

          {%- if form.password_needed -%}
            <div>
              <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
                <label for="CustomerPassword" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600;">
                  Password
                </label>
                <a href="#recover" onclick="document.getElementById('RecoverPasswordForm').style.display='block'; document.getElementById('CustomerLoginForm').style.display='none';" style="font-size: 0.78rem; color: var(--color-accent); text-decoration: underline;">
                  Forgot password?
                </a>
              </div>
              <input
                type="password"
                name="customer[password]"
                id="CustomerPassword"
                autocomplete="current-password"
                required
                style="width: 100%; padding: 0.85rem; border: 1px solid var(--color-border); border-radius: 2px;"
              >
            </div>
          {%- endif -%}

          <button type="submit" class="btn btn-primary btn-block" style="padding: 1rem; margin-top: 0.5rem;">
            Sign In
          </button>

          <div style="text-align: center; margin-top: 1rem; font-size: 0.9rem; color: var(--color-text-muted);">
            Don't have an account?
            <a href="{{ routes.account_register_url }}" style="color: var(--color-text-main); font-weight: 600; text-decoration: underline;">
              Create one now
            </a>
          </div>
        </div>
      {% endform %}
    </div>

    <!-- Password Recovery Form -->
    <div id="RecoverPasswordForm" style="display: none; background: #FFFFFF; border: 1px solid var(--color-border); border-radius: 4px; padding: 2.5rem;">
      <h2 style="font-size: 1.8rem; text-align: center; margin-bottom: 0.75rem;">Reset Your Password</h2>
      <p style="text-align: center; color: var(--color-text-muted); font-size: 0.9rem; margin-bottom: 1.75rem;">
        We will send you an email to reset your password.
      </p>

      {% form 'recover_customer_password' %}
        {%- if form.errors -%}
          <div style="color: var(--color-sale); margin-bottom: 1rem; font-size: 0.88rem;">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          <div>
            <label for="RecoverEmail" style="display: block; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; margin-bottom: 0.4rem;">
              Email Address
            </label>
            <input
              type="email"
              name="email"
              id="RecoverEmail"
              required
              autocomplete="email"
              style="width: 100%; padding: 0.85rem; border: 1px solid var(--color-border); border-radius: 2px;"
            >
          </div>

          <button type="submit" class="btn btn-primary btn-block" style="padding: 0.95rem;">
            Submit
          </button>

          <div style="text-align: center;">
            <a href="#login" onclick="document.getElementById('RecoverPasswordForm').style.display='none'; document.getElementById('CustomerLoginForm').style.display='block';" class="btn-link" style="font-size: 0.8rem;">
              Cancel &amp; Return to Sign In
            </a>
          </div>
        </div>
      {% endform %}
    </div>
  </div>
</section>
