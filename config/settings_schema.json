[
  {
    "name": "theme_info",
    "theme_name": "Caperino Luxury Furniture & Interior",
    "theme_version": "1.0.0",
    "theme_author": "Caperino Furnitures & Interiors",
    "theme_documentation_url": "https://help.shopify.com",
    "theme_support_url": "https://help.shopify.com"
  },
  {
    "name": "Brand & Identity",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Store Logo"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "text",
        "id": "business_phone",
        "label": "Customer Support Phone",
        "default": "+92 300 9630392"
      },
      {
        "type": "text",
        "id": "business_location",
        "label": "Store Location",
        "default": "Main Vehari Road, near Chungi No. 22, Timber Market, Multan, Punjab, Pakistan"
      }
    ]
  },
  {
    "name": "Colors & Aesthetics",
    "settings": [
      {
        "type": "color",
        "id": "color_bg",
        "label": "Primary Background",
        "default": "#FAF8F5"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface / Card Background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_surface_warm",
        "label": "Warm Editorial Background",
        "default": "#F4EFEB"
      },
      {
        "type": "color",
        "id": "color_text_main",
        "label": "Headings & Main Text",
        "default": "#1D1A16"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Artisan Bronze / Accent",
        "default": "#9B7653"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale / Alert Color",
        "default": "#8E3A2B"
      }
    ]
  },
  {
    "name": "Social Media Links",
    "settings": [
      {
        "type": "paragraph",
        "content": "Only icons with entered links will be displayed on the store. Leave empty to hide."
      },
      {
        "type": "url",
        "id": "social_instagram_link",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "social_facebook_link",
        "label": "Facebook URL"
      },
      {
        "type": "url",
        "id": "social_pinterest_link",
        "label": "Pinterest URL"
      },
      {
        "type": "url",
        "id": "social_youtube_link",
        "label": "YouTube URL"
      }
    ]
  },
  {
    "name": "Cart Drawer Settings",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_drawer_enabled",
        "label": "Enable AJAX Slide-out Cart Drawer",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_notes_enabled",
        "label": "Enable Cart Delivery Notes",
        "default": true
      }
