<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }} &ndash; Coming Soon</title>
    {{ content_for_header }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
  </head>
  <body style="min-height: 100vh; display: flex; align-items: center; justify-content: center; text-align: center; background-color: var(--color-surface-warm);">
    <div style="max-width: 540px; padding: 2.5rem; background: #fff; border-radius: 4px; box-shadow: var(--shadow-md);">
      <h1 style="font-family: var(--font-heading); margin-bottom: 0.5rem;">{{ shop.name }}</h1>
      <p style="color: var(--color-text-muted); margin-bottom: 2rem;">Our new furniture and interior online showroom is coming soon.</p>
      {{ content_for_layout }}
    </div>
  </body>
</html>
