<section class="section-spacing" style="background-color: var(--color-bg);" aria-label="Shop By Category">
  <div class="container">
    <div class="section-header text-center">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="section-subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="category-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign cat_title = block.settings.title
          assign cat_link = block.settings.link | default: block.settings.collection.url | default: '/collections/all'
          assign cat_image = block.settings.image | default: block.settings.collection.featured_image
        -%}
        <a href="{{ cat_link }}" class="category-card" {{ block.shopify_attributes }}>
          <div class="category-card-media">
            {%- if cat_image != blank -%}
              <img
                src="{{ cat_image | image_url: width: 600 }}"
                alt="{{ cat_title | escape }}"
                loading="lazy"
                width="600"
                height="750"
              >
            {%- elsif block.settings.default_image_url != blank -%}
              <img
                src="{{ block.settings.default_image_url }}"
                alt="{{ cat_title | escape }}"
                loading="lazy"
                width="600"
                height="750"
              >
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag }}
            {%- endif -%}
            <div class="category-card-overlay"></div>
          </div>
          <div class="category-card-content">
            <h3 class="category-card-title">{{ cat_title }}</h3>
            <span class="category-card-link">
              Explore Collection &rarr;
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop By Category",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow tag",
      "default": "Curated Collections"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop By Category"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore our curated furniture and interior design collections for every space."
    }
  ],
  "blocks": [
    {
      "type": "category_item",
      "name": "Category Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Living Room"
        },
