{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show | default: 4
-%}

<section class="section-spacing" style="background-color: var(--color-bg);" aria-label="Bedroom Furniture">
  <div class="container">
    <div class="editorial-split-grid reversed">
      <div class="editorial-split-media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            alt="{{ section.settings.heading | escape }}"
            loading="lazy"
            width="1200"
            height="850"
          >
        {%- else -%}
          <img
            src="https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=1200&q=80"
            alt="Bedroom Furniture by Caperino"
            loading="lazy"
          >
        {%- endif -%}
      </div>

      <div class="editorial-split-content">
        <span class="section-eyebrow">{{ section.settings.eyebrow | default: 'Sanctuary & Rest' }}</span>
        <h2 class="section-title">{{ section.settings.heading | default: 'Comfort Starts at Home' }}</h2>
        <p style="color: var(--color-text-muted); font-size: 1.05rem; line-height: 1.65;">
          {{ section.settings.description | default: 'Create your personal retreat. Thoughtfully constructed bed frames, nightstands, wardrobes, and dressing consoles designed with balanced proportions.' }}
        </p>

        <div class="editorial-subcategories">
          <a href="/collections/beds" class="editorial-subcat-pill">Beds</a>
          <a href="/collections/bedside-tables" class="editorial-subcat-pill">Bedside Tables</a>
          <a href="/collections/dressing-tables" class="editorial-subcat-pill">Dressing Tables</a>
          <a href="/collections/wardrobes" class="editorial-subcat-pill">Wardrobes</a>
          <a href="/collections/bedroom-benches" class="editorial-subcat-pill">Bedroom Benches</a>
          <a href="/collections/bedroom-mirrors" class="editorial-subcat-pill">Mirrors</a>
          <a href="/collections/mattresses" class="editorial-subcat-pill">Mattresses</a>
        </div>

        <a href="{{ section.settings.link | default: '/collections/bedroom' }}" class="btn btn-primary">
          {{ section.settings.cta_text | default: 'Shop Bedroom' }}
        </a>
      </div>
    </div>

    {%- if collection != blank and collection.products.size > 0 -%}
      <div style="margin-top: 3.5rem;">
        <div class="product-grid">
          {%- for product in collection.products limit: limit -%}
            {% render 'product-card', product_card_product: product %}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bedroom Section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow tag",
      "default": "Sanctuary & Rest"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Comfort Starts at Home"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Create your personal retreat. Thoughtfully constructed bed frames, nightstands, wardrobes, and dressing consoles designed with balanced proportions."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial Image"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Shop Bedroom"
    },
    {
      "type": "url",
      "id": "link",
      "label": "CTA Button Link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Associated Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 2,
      "default": 4,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Bedroom Section"
    }
  ]
}
{% endschema %}
