{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show | default: 4
-%}

<section class="section-spacing" style="background-color: var(--color-surface-warm);" aria-label="Rugs and Textiles">
  <div class="container">
    <div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; margin-bottom: clamp(2rem, 4vw, 3.5rem); gap: 1rem;">
      <div>
        <span class="section-eyebrow">{{ section.settings.eyebrow | default: 'Texture & Warmth' }}</span>
        <h2 class="section-title">{{ section.settings.heading | default: 'Rugs & Textiles' }}</h2>
        <p style="color: var(--color-text-muted); font-size: 1rem;">
          {{ section.settings.subheading | default: 'Area rugs, runners, Persian weaves, and soft textiles to ground your living and bedroom spaces.' }}
        </p>
      </div>
      <a href="{{ section.settings.link | default: '/collections/rugs' }}" class="btn-link">
        {{ section.settings.cta_text | default: 'Explore Rugs & Textiles' }} &rarr;
      </a>
    </div>

    <div class="editorial-subcategories" style="margin-top: 0; margin-bottom: 2.5rem;">
      <a href="/collections/area-rugs" class="editorial-subcat-pill">Area Rugs</a>
      <a href="/collections/persian-rugs" class="editorial-subcat-pill">Persian Rugs</a>
      <a href="/collections/modern-rugs" class="editorial-subcat-pill">Modern Rugs</a>
      <a href="/collections/runners" class="editorial-subcat-pill">Runners</a>
      <a href="/collections/carpets" class="editorial-subcat-pill">Carpets</a>
      <a href="/collections/floor-mats" class="editorial-subcat-pill">Floor Mats</a>
      <a href="/collections/curtains" class="editorial-subcat-pill">Curtains</a>
      <a href="/collections/cushions" class="editorial-subcat-pill">Cushions</a>
      <a href="/collections/throws" class="editorial-subcat-pill">Throws</a>
    </div>

    <div class="product-grid">
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: limit -%}
          {% render 'product-card', product_card_product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <div class="product-card">
            <div class="product-card-image-wrap">
              {{ 'collection-' | append: i | placeholder_svg_tag: 'product-card-img primary-img' }}
            </div>
            <div class="product-card-info">
              <div class="product-card-vendor">Caperino Textiles</div>
              <h3 class="product-card-title">Handwoven Rug {{ i }}</h3>
              <div class="product-card-price-wrap">
                <span class="price-regular">Shopify Collection Demo</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rugs & Textiles Section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow tag",
      "default": "Texture & Warmth"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Rugs & Textiles"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Area rugs, runners, Persian weaves, and soft textiles to ground your living and bedroom spaces."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "Explore Rugs & Textiles"
    },
    {
      "type": "url",
      "id": "link",
      "label": "CTA Link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Rugs Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 8,
      "step": 4,
      "default": 4,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Rugs & Textiles Section"
    }
  ]
}
{% endschema %}
