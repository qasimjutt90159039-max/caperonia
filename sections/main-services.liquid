<section class="section-spacing" aria-label="Interior Services">
  <div class="container">
    <div class="section-header text-center" style="max-width: 680px; margin: 0 auto 3.5rem;">
      <span class="section-eyebrow">Expertise &amp; Capabilities</span>
      <h1 class="section-title">Interior &amp; Furniture Services</h1>
      <p class="section-subtitle">
        We collaborate with homeowners, architects, and designers to realize distinctive furniture and interior concepts.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.75rem;">
      {%- for block in section.blocks -%}
        <div style="background: #FFFFFF; border: 1px solid var(--color-border); border-radius: 4px; padding: 2.25rem 1.75rem; display: flex; flex-direction: column; justify-content: space-between;" {{ block.shopify_attributes }}>
          <div>
            <div style="width: 44px; height: 44px; border-radius: 4px; background: var(--color-surface-warm); color: var(--color-accent); display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem;">
              <svg style="width: 22px; height: 22px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <h2 style="font-family: var(--font-heading); font-size: 1.35rem; margin-bottom: 0.75rem;">{{ block.settings.title }}</h2>
            <p style="color: var(--color-text-muted); font-size: 0.92rem; line-height: 1.6; margin-bottom: 1.5rem;">
              {{ block.settings.description }}
            </p>
          </div>
          <div>
            <a href="/pages/contact" class="btn-link" style="font-size: 0.8rem;">Inquire About This Service &rarr;</a>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div style="margin-top: 4rem; text-align: center; background: var(--color-surface-warm); padding: 3rem 1.5rem; border-radius: 4px;">
      <h3 style="font-family: var(--font-heading); font-size: 1.75rem; margin-bottom: 0.5rem;">Need a Consultation for Your Project?</h3>
      <p style="color: var(--color-text-muted); font-size: 1rem; max-width: 540px; margin: 0 auto 1.75rem;">
        Speak directly with our team to discuss project requirements, wood selection, custom dimensions, or spatial planning.
      </p>
      <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
        <a href="tel:+923009630392" class="btn btn-primary">Call +92 300 9630392</a>
        <a href="/pages/contact" class="btn btn-secondary">Submit Inquiry</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Interior Services",
  "blocks": [
    {
      "type": "service_block",
      "name": "Service Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Service Title",
          "default": "Custom Furniture Crafting"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Service Description",
          "default": "Tailored sizing, wood species selection, and upholstery options engineered to fit your specific architectural dimensions."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Interior Services",
      "blocks": [
        {
          "type": "service_block",
          "settings": {
            "title": "Furniture Consultation",
            "description": "Guidance on wood finishes, seating ergonomics, spatial layouts, and matching collections to existing room palettes."
          }
        },
        {
          "type": "service_block",
          "settings": {
            "title": "Custom Furniture Sizing",
            "description": "Customizable dimensions on select beds, dining tables, consoles, and sofas to fit your home's unique layout."
          }
        },
        {
          "type": "service_block",
          "settings": {
            "title": "Residential Interiors",
            "description": "Coordinated selection of wall paneling, focal mirrors, lighting fixtures, and loose furniture for home interiors."
          }
        },
        {
          "type": "service_block",
          "settings": {
            "title": "Commercial & Office Spaces",
            "description": "Reception desks, executive desks, conference tables, and durable seating for modern commercial workspaces."
          }
        },
        {
          "type": "service_block",
          "settings": {
            "title": "Space Planning & Layouts",
            "description": "Assistance in arranging furniture for optimal flow, natural light utilization, and balanced spatial proportions."
          }
        },
        {
          "type": "service_block",
          "settings": {
            "title": "On-Site Installation Support",
            "description": "Assistance with assembly and placement of heavy solid timber pieces, bed frames, and modular wardrobes upon delivery."
          }
        }
      ]
    }
  ]
}
{% endschema %}
