{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show | default: 4
-%}

<section class="section-spacing editorial-split" aria-label="Living Room Collection">
  <div class="container">
    <div class="editorial-split-grid">
      <div class="editorial-split-media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            alt="{{ section.settings.heading | escape }}"
            loading="lazy"
            width="1200"
            height="850"
          >
        {%- else -%}
          <img
            src="https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=1200&q=80"
            alt="Living Room Furniture by Caperino"
            loading="lazy"
          >
        {%- endif -%}
      </div>

      <div class="editorial-split-content">
        <span class="section-eyebrow">{{ section.settings.eyebrow | default: 'Living Space' }}</span>
        <h2 class="section-title">{{ section.settings.heading | default: 'Create a Living Room You Love' }}</h2>
        <p style="color: var(--color-text-muted); font-size: 1.05rem; line-height: 1.65;">
          {{ section.settings.description | default: 'The living room is where everyday life unfolds. Explore sofas, sectionals, consoles, and artisanal coffee tables designed for warmth and timeless presence.' }}
        </p>

        <div class="editorial-subcategories">
          <a href="/collections/sofas" class="editorial-subcat-pill">Sofas</a>
          <a href="/collections/sectional-sofas" class="editorial-subcat-pill">Sectional Sofas</a>
          <a href="/collections/armchairs" class="editorial-subcat-pill">Armchairs</a>
          <a href="/collections/coffee-tables" class="editorial-subcat-pill">Coffee Tables</a>
          <a href="/collections/tv-units" class="editorial-subcat-pill">TV Units</a>
          <a href="/collections/side-tables" class="editorial-subcat-pill">Side Tables</a>
          <a href="/collections/consoles" class="editorial-subcat-pill">Consoles</a>
          <a href="/collections/shelving" class="editorial-subcat-pill">Shelving</a>
        </div>

        <a href="{{ section.settings.link | default: '/collections/living-room' }}" class="btn btn-primary">
          {{ section.settings.cta_text | default: 'Shop Living Room' }}
        </a>
      </div>
    </div>

    {%- if collection != blank and collection.products.size > 0 -%}
      <div style="margin-top: 3.5rem;">
        <div class="product-grid">
          {%- for product in collection.products limit: limit -%}
            {% render 'product-card', product_card_product: product %}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Living Room Section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow tag",
      "default": "Living Space"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Create a Living Room You Love"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "The living room is where everyday life unfolds. Explore sofas, sectionals, consoles, and artisanal coffee tables designed for warmth and timeless presence."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial Image"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Shop Living Room"
    },
    {
      "type": "url",
      "id": "link",
      "label": "CTA Button Link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Associated Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 2,
      "default": 4,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Living Room Section"
    }
  ]
}
{% endschema %}
