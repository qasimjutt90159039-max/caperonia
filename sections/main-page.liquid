<section class="section-spacing" aria-label="{{ page.title | escape }}">
  <div class="container container-narrow">
    <div class="section-header text-center" style="margin-bottom: 3rem;">
      <h1 class="section-title">{{ page.title }}</h1>
    </div>

    <div class="rte" style="line-height: 1.8; color: var(--color-text-main); font-size: 1.05rem;">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Standard Page",
  "settings": []
}
{% endschema %}
