<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-top">
      <!-- Col 1: Business Details -->
      <div class="footer-col">
        <h3 class="footer-col-title" style="font-size: 1.4rem;">{{ shop.name | default: 'Caperino Furnitures & Interiors' }}</h3>
        <div class="footer-business-details">
          <p>
            <strong>Showroom & Workshop:</strong><br>
            Main Vehari Road, near Chungi No. 22, Timber Market,<br>
            Multan, Punjab, Pakistan
          </p>
          <p>
            <strong>Phone:</strong><br>
            <a href="tel:+923009630392">+92 300 9630392</a>
          </p>
          <p style="font-size: 0.8rem; color: var(--color-dark-muted);">
            Furniture &bull; Home Interior &bull; Home Decor &bull; E-commerce
          </p>
        </div>

        {%- comment -%}
          Social Media: Only display when merchant has configured URLs in theme settings
        {%- endcomment -%}
        {%- if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_pinterest_link != blank or settings.social_youtube_link != blank -%}
          <div class="social-links">
            {%- if settings.social_facebook_link != blank -%}
              <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" class="social-icon-link" aria-label="Facebook">
                <svg style="width: 18px; height: 18px;" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
              </a>
            {%- endif -%}
            {%- if settings.social_instagram_link != blank -%}
              <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" class="social-icon-link" aria-label="Instagram">
                <svg style="width: 18px; height: 18px;" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </a>
            {%- endif -%}
            {%- if settings.social_pinterest_link != blank -%}
              <a href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener" class="social-icon-link" aria-label="Pinterest">
                <svg style="width: 18px; height: 18px;" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.291 1.199-.334 1.376-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>
              </a>
            {%- endif -%}
            {%- if settings.social_youtube_link != blank -%}
              <a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener" class="social-icon-link" aria-label="YouTube">
                <svg style="width: 18px; height: 18px;" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Col 2: Shop Navigation -->
      <div class="footer-col">
        <h4 class="footer-col-title">Shop</h4>
        <ul class="footer-links">
          <li><a href="/collections/furniture">Furniture</a></li>
          <li><a href="/collections/living-room">Living Room</a></li>
          <li><a href="/collections/bedroom">Bedroom</a></li>
          <li><a href="/collections/dining">Dining</a></li>
          <li><a href="/collections/home-decor">Home Decor</a></li>
          <li><a href="/collections/lighting">Lighting</a></li>
          <li><a href="/collections/rugs">Rugs & Textiles</a></li>
          <li><a href="/collections/new-arrivals">New Arrivals</a></li>
        </ul>
      </div>

      <!-- Col 3: Customer Care -->
      <div class="footer-col">
        <h4 class="footer-col-title">Customer Care</h4>
        <ul class="footer-links">
          <li><a href="/pages/contact">Contact Us</a></li>
          <li><a href="/pages/faq">Frequently Asked Questions</a></li>
          <li><a href="/pages/services">Interior Services</a></li>
          <li><a href="/pages/inspiration">Design Inspiration</a></li>
          <li><a href="/pages/shipping-policy">Shipping Policy</a></li>
          <li><a href="/pages/return-policy">Return & Refund Policy</a></li>
          <li><a href="/pages/privacy-policy">Privacy Policy</a></li>
          <li><a href="/pages/terms">Terms & Conditions</a></li>
        </ul>
      </div>

      <!-- Col 4: Quick Newsletter & Hours -->
      <div class="footer-col">
        <h4 class="footer-col-title">Stay Inspired</h4>
        <p style="font-size: 0.85rem; color: var(--color-dark-muted); margin-bottom: 1.25rem;">
          Subscribe to receive design perspectives, new furniture drops, and exclusive seasonal releases.
        </p>
        {% form 'customer', class: 'newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input
            type="email"
            name="contact[email]"
            class="newsletter-input"
            placeholder="Your email address"
            required
            style="width: 100%; border-radius: 2px; margin-bottom: 0.6rem; padding: 0.75rem 1rem; font-size: 0.85rem;"
          >
          <button type="submit" class="btn btn-primary btn-block" style="background: var(--color-accent); border-color: var(--color-accent); padding: 0.75rem;">
            Subscribe
          </button>
        {% endform %}
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="footer-bottom">
      <div>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: 'Caperino Furnitures & Interiors' }}. All rights reserved.
      </div>
      <div>
        <span>Powered by Shopify</span>
        <span style="margin: 0 8px;">&bull;</span>
        <span>Timber Market, Multan</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Additional copyright text"
    }
  ]
}
{% endschema %}
