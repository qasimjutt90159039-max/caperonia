{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show | default: 4
-%}

<section class="section-spacing" style="background-color: var(--color-surface);" aria-label="Best Sellers">
  <div class="container">
    <div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; margin-bottom: clamp(2rem, 4vw, 3.5rem); gap: 1rem;">
      <div>
        <span class="section-eyebrow">{{ section.settings.eyebrow | default: 'Customer Favorites' }}</span>
        <h2 class="section-title">{{ section.settings.heading | default: 'Best Sellers' }}</h2>
        <p style="color: var(--color-text-muted); font-size: 1rem;">
          {{ section.settings.subheading | default: 'Our most sought-after living, dining, and bedroom furniture.' }}
        </p>
      </div>
      {%- if collection != blank -%}
        <a href="{{ collection.url }}" class="btn-link">View Collection &rarr;</a>
      {%- else -%}
        <a href="/collections/all" class="btn-link">View All Furniture &rarr;</a>
      {%- endif -%}
    </div>

    <div class="product-grid">
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: limit -%}
          {% render 'product-card', product_card_product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <div class="product-card">
            <div class="product-card-image-wrap">
              {{ 'product-' | append: i | placeholder_svg_tag: 'product-card-img primary-img' }}
            </div>
            <div class="product-card-info">
              <div class="product-card-vendor">Caperino Furnitures</div>
              <h3 class="product-card-title">Popular Item {{ i }}</h3>
              <div class="product-card-price-wrap">
                <span class="price-regular">Shopify Dynamic Collection</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Best Sellers",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow tag",
      "default": "Customer Favorites"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our most sought-after living, dining, and bedroom furniture."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Best Sellers Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 8,
      "step": 4,
      "default": 4,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Best Sellers"
    }
  ]
}
{% endschema %}
