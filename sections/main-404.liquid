<section class="section-spacing" style="min-height: 60vh; display: flex; align-items: center; justify-content: center; text-align: center;">
  <div class="container container-narrow">
    <span class="section-eyebrow" style="font-size: 1rem; color: var(--color-accent);">404 Error</span>
    <h1 style="font-size: clamp(2.5rem, 5vw, 4rem); margin-bottom: 1rem;">Page Not Found</h1>
    <p style="color: var(--color-text-muted); font-size: 1.1rem; max-width: 500px; margin: 0 auto 2.5rem;">
      The furniture piece or page you are looking for might have been moved, renamed, or is currently unavailable.
    </p>
    <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
      <a href="{{ routes.root_url }}" class="btn btn-primary">Return to Homepage</a>
      <a href="/collections/all" class="btn btn-secondary">Browse Collections</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404 Page",
  "settings": []
}
{% endschema %}
