{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show | default: 4
-%}

<section class="section-spacing editorial-split" style="background-color: var(--color-surface-warm);" aria-label="Dining Room Collection">
  <div class="container">
    <div class="editorial-split-grid">
      <div class="editorial-split-media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            alt="{{ section.settings.heading | escape }}"
            loading="lazy"
            width="1200"
            height="850"
          >
        {%- else -%}
          <img
            src="https://images.unsplash.com/photo-1617806118233-18e1de247200?auto=format&fit=crop&w=1200&q=80"
            alt="Dining Furniture by Caperino"
            loading="lazy"
          >
        {%- endif -%}
      </div>

      <div class="editorial-split-content">
        <span class="section-eyebrow">{{ section.settings.eyebrow | default: 'Shared Moments' }}</span>
        <h2 class="section-title">{{ section.settings.heading | default: 'Gather Around Something Beautiful' }}</h2>
        <p style="color: var(--color-text-muted); font-size: 1.05rem; line-height: 1.65;">
          {{ section.settings.description | default: 'From intimate morning meals to grand celebratory dinners, our solid dining tables, comfortable upholstered chairs, and storage sideboards anchor your gathering space.' }}
        </p>

        <div class="editorial-subcategories">
          <a href="/collections/dining-tables" class="editorial-subcat-pill">Dining Tables</a>
          <a href="/collections/dining-chairs" class="editorial-subcat-pill">Dining Chairs</a>
          <a href="/collections/dining-sets" class="editorial-subcat-pill">Dining Sets</a>
          <a href="/collections/sideboards" class="editorial-subcat-pill">Sideboards</a>
          <a href="/collections/cabinets" class="editorial-subcat-pill">Cabinets</a>
          <a href="/collections/bar-stools" class="editorial-subcat-pill">Bar Stools</a>
        </div>

        <a href="{{ section.settings.link | default: '/collections/dining' }}" class="btn btn-primary">
          {{ section.settings.cta_text | default: 'Explore Dining' }}
        </a>
      </div>
    </div>

    {%- if collection != blank and collection.products.size > 0 -%}
      <div style="margin-top: 3.5rem;">
        <div class="product-grid">
          {%- for product in collection.products limit: limit -%}
            {% render 'product-card', product_card_product: product %}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Dining Section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow tag",
      "default": "Shared Moments"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gather Around Something Beautiful"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "From intimate morning meals to grand celebratory dinners, our solid dining tables, comfortable upholstered chairs, and storage sideboards anchor your gathering space."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial Image"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Explore Dining"
    },
    {
      "type": "url",
      "id": "link",
      "label": "CTA Button Link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Associated Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 2,
      "default": 4,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Dining Section"
    }
  ]
}
{% endschema %}
