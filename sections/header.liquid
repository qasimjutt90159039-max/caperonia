{%- liquid
  assign main_menu = section.settings.menu | default: 'main-menu'
-%}

<header class="site-header" role="banner">
  <div class="container header-wrapper">
    <!-- Hamburger for Mobile -->
    <button type="button" class="header-hamburger" aria-label="Open navigation menu">
      <svg style="width: 24px; height: 24px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- Brand Logo -->
    <div class="header-logo">
      <a href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: section.settings.logo_width }}"
            alt="{{ shop.name }}"
            width="{{ section.settings.logo_width }}"
            height="auto"
            loading="eager"
          >
        {%- else -%}
          <span class="brand-name">{{ shop.name | default: 'Caperino' }}</span>
          <span class="brand-tagline">Furnitures & Interiors</span>
        {%- endif -%}
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="header-nav" role="navigation" aria-label="Primary Navigation">
      {%- if linklists[main_menu].links.size > 0 -%}
        {%- for link in linklists[main_menu].links -%}
          <a
            href="{{ link.url }}"
            class="nav-link {% if link.active %}is-active{% endif %}"
          >
            {{ link.title }}
          </a>
        {%- endfor -%}
      {%- else -%}
        <!-- Default fallback navigation matching specifications -->
        <a href="{{ routes.root_url }}" class="nav-link is-active">Home</a>
        <a href="/collections/all" class="nav-link">Shop</a>
        <a href="/collections/furniture" class="nav-link">Furniture</a>
        <a href="/collections/living-room" class="nav-link">Living Room</a>
        <a href="/collections/bedroom" class="nav-link">Bedroom</a>
        <a href="/collections/dining" class="nav-link">Dining</a>
        <a href="/collections/home-decor" class="nav-link">Home Decor</a>
        <a href="/collections/interior-products" class="nav-link">Interior</a>
        <a href="/collections/new-arrivals" class="nav-link">New Arrivals</a>
        <a href="/pages/contact" class="nav-link">Contact</a>
      {%- endif -%}
    </nav>

    <!-- Header Actions (Right) -->
    <div class="header-actions">
      <!-- Search Trigger -->
      <button type="button" class="action-btn" data-trigger-search aria-label="Search furniture">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>

      <!-- Customer Account -->
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="action-btn" aria-label="Customer Account">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </a>
      {%- endif -%}

      <!-- Wishlist Trigger -->
      <button type="button" class="action-btn" data-trigger-wishlist aria-label="Wishlist">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
        <span class="badge-count wishlist-badge-count" style="display: none;">0</span>
      </button>

      <!-- Cart Drawer Trigger -->
      <button type="button" class="action-btn header-cart-btn" data-trigger-cart aria-label="Shopping Cart">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        <span class="badge-count cart-badge-count" style="{% if cart.item_count == 0 %}display: none;{% endif %}">{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div class="mobile-nav-drawer" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
  <div class="mobile-nav-content">
    <div style="display: flex; align-items: center; justify-content: space-between;">
      <div>
        <span class="brand-name" style="font-size: 1.4rem;">{{ shop.name | default: 'Caperino' }}</span>
        <span class="brand-tagline" style="display: block; font-size: 0.6rem;">Furnitures & Interiors</span>
      </div>
      <button type="button" class="mobile-nav-close" style="background: none; border: none; cursor: pointer; padding: 0.3rem;" aria-label="Close menu">
        <svg style="width: 22px; height: 22px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <ul class="mobile-nav-links">
      {%- if linklists[main_menu].links.size > 0 -%}
        {%- for link in linklists[main_menu].links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
      {%- else -%}
        <li><a href="{{ routes.root_url }}">Home</a></li>
        <li><a href="/collections/all">Shop All</a></li>
        <li><a href="/collections/furniture">Furniture</a></li>
        <li><a href="/collections/living-room">Living Room</a></li>
        <li><a href="/collections/bedroom">Bedroom</a></li>
        <li><a href="/collections/dining">Dining</a></li>
        <li><a href="/collections/home-decor">Home Decor</a></li>
        <li><a href="/collections/interior-products">Interior Products</a></li>
        <li><a href="/collections/new-arrivals">New Arrivals</a></li>
        <li><a href="/pages/contact">Contact Us</a></li>
      {%- endif -%}
    </ul>

    <div class="mobile-nav-footer">
      <div style="margin-bottom: 0.5rem; font-weight: 600; color: var(--color-text-main);">Store Location:</div>
      <p style="margin-bottom: 0.5rem; font-size: 0.8rem;">Main Vehari Road, near Chungi No. 22, Timber Market, Multan</p>
      <a href="tel:+923009630392" style="font-weight: 600; color: var(--color-accent); font-size: 0.85rem;">+92 300 9630392</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 260,
      "step": 10,
      "default": 170,
      "unit": "px",
      "label": "Logo width"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Primary navigation menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
