<section class="section-spacing" aria-label="Design Inspiration & Styling">
  <div class="container">
    <div class="section-header text-center" style="max-width: 720px; margin: 0 auto 3.5rem;">
      <span class="section-eyebrow">Design Perspectives</span>
      <h1 class="section-title">Interior &amp; Furniture Inspiration</h1>
      <p class="section-subtitle">
        Explore visual styling concepts and spatial design ideas to help you envision Caperino furniture and interior pieces in your home.
      </p>
      <p style="font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-accent); margin-top: 0.75rem;">
        Note: The curated gallery below illustrates interior design concepts and styling possibilities. Real client showcase projects will be featured here as they are documented.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: 1fr; gap: 2.5rem;" class="inspiration-grid">
      {%- for block in section.blocks -%}
        <div style="display: grid; grid-template-columns: 1fr; gap: 2rem; background: #FFFFFF; border: 1px solid var(--color-border); border-radius: 4px; overflow: hidden;" class="inspiration-card-grid" {{ block.shopify_attributes }}>
          <div style="aspect-ratio: 16/10; overflow: hidden; background: var(--color-surface-warm);">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 1000 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                style="width: 100%; height: 100%; object-fit: cover;"
              >
            {%- elsif block.settings.fallback_image != blank -%}
              <img
                src="{{ block.settings.fallback_image }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                style="width: 100%; height: 100%; object-fit: cover;"
              >
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div style="padding: clamp(1.5rem, 3vw, 2.5rem); display: flex; flex-direction: column; justify-content: center;">
            <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-accent); font-weight: 600; margin-bottom: 0.5rem;">
              {{ block.settings.category_tag | default: 'Styling Concept' }}
            </span>
            <h2 style="font-family: var(--font-heading); font-size: 1.85rem; margin-bottom: 0.75rem; line-height: 1.25;">
              {{ block.settings.title }}
            </h2>
            <p style="color: var(--color-text-muted); font-size: 0.95rem; line-height: 1.65; margin-bottom: 1.5rem;">
              {{ block.settings.description }}
            </p>
            <div>
              <a href="{{ block.settings.link | default: '/collections/all' }}" class="btn btn-secondary">
                {{ block.settings.button_text | default: 'Explore Featured Pieces' }} &rarr;
              </a>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  @media (min-width: 860px) {
    .inspiration-card-grid {
      grid-template-columns: 1.2fr 1fr !important;
    }
  }
</style>

{% schema %}
{
  "name": "Inspiration Gallery",
  "blocks": [
    {
      "type": "inspiration_item",
      "name": "Inspiration Room",
      "settings": [
        {
          "type": "text",
          "id": "category_tag",
          "label": "Room Tag",
          "default": "Living Room Inspiration"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Warm Minimalism Living Space"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "A balanced composition featuring neutral upholstered seating, natural timber coffee tables, and subtle architectural wall paneling."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Inspiration Image"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "Fallback Image URL"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Collection Link"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Shop Related Furniture"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Inspiration Gallery",
      "blocks": [
        {
          "type": "inspiration_item",
          "settings": {
            "category_tag": "Living Room Inspiration",
            "title": "Warm Minimalist Living Room",
            "description": "Layered textures, solid timber coffee tables, and deep cushioned seating create an inviting living sanctuary.",
            "fallback_image": "https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=1000&q=80",
            "link": "/collections/living-room"
          }
        },
        {
          "type": "inspiration_item",
          "settings": {
            "category_tag": "Bedroom Inspiration",
            "title": "Serene Contemporary Bedroom",
            "description": "Structured upholstered headboards paired with minimalist nightstands for quiet elegance and restful comfort.",
            "fallback_image": "https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=1000&q=80",
            "link": "/collections/bedroom"
          }
        },
        {
          "type": "inspiration_item",
          "settings": {
            "category_tag": "Dining Inspiration",
            "title": "Architectural Dining Setting",
            "description": "Solid hardwood dining tables surrounded by comfortable supportive chairs, anchored by warm ambient lighting.",
            "fallback_image": "https://images.unsplash.com/photo-1617806118233-18e1de247200?auto=format&fit=crop&w=1000&q=80",
            "link": "/collections/dining"
          }
        },
        {
          "type": "inspiration_item",
          "settings": {
            "category_tag": "Modern Interiors",
            "title": "Feature Wall Paneling & Lighting",
            "description": "Textured wall panel accents and directional sconces elevate standard living and reception rooms into designer spaces.",
            "fallback_image": "https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=1000&q=80",
            "link": "/collections/interior-products"
          }
        }
      ]
    }
  ]
}
{% endschema %}
