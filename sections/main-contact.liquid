<section class="section-spacing" aria-label="Contact Caperino">
  <div class="container">
    <div class="section-header text-center" style="max-width: 640px; margin: 0 auto 3.5rem;">
      <span class="section-eyebrow">Get In Touch</span>
      <h1 class="section-title">Contact Us</h1>
      <p class="section-subtitle">
        Have questions regarding our furniture collections, custom orders, or interior pieces? Reach out to our team in Multan.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: 1fr; gap: clamp(2rem, 5vw, 4rem); max-width: 1040px; margin: 0 auto;" class="contact-grid-wrap">
      <!-- Business Info -->
      <div style="background: var(--color-surface-warm); padding: 2.5rem; border-radius: 4px; display: flex; flex-direction: column; gap: 1.5rem;">
        <h2 style="font-family: var(--font-heading); font-size: 1.75rem;">Caperino Furnitures &amp; Interiors</h2>
        
        <div>
          <strong style="display: block; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-accent); margin-bottom: 0.35rem;">
            Showroom &amp; Timber Market Location:
          </strong>
          <p style="color: var(--color-text-main); font-size: 1rem; line-height: 1.6;">
            Main Vehari Road, near Chungi No. 22,<br>
            Timber Market, Multan,<br>
            Punjab, Pakistan
          </p>
        </div>

        <div>
          <strong style="display: block; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-accent); margin-bottom: 0.35rem;">
            Telephone / Direct WhatsApp:
          </strong>
          <a href="tel:+923009630392" style="color: var(--color-text-main); font-size: 1.15rem; font-weight: 600;">
            +92 300 9630392
          </a>
        </div>

        <div style="margin-top: auto; padding-top: 1.5rem; border-top: 1px solid var(--color-border); font-size: 0.88rem; color: var(--color-text-muted);">
          Visit our Multan showroom to inspect wood finishes, fabrics, and custom interior solutions in person.
        </div>
      </div>

      <!-- Contact Form -->
      <div style="background: #FFFFFF; border: 1px solid var(--color-border); padding: 2.5rem; border-radius: 4px;">
        <h2 style="font-family: var(--font-heading); font-size: 1.75rem; margin-bottom: 1.25rem;">Send a Message</h2>

        {% form 'contact', id: 'ContactForm' %}
          {%- if form.posted_successfully? -%}
            <div style="background: rgba(58, 105, 75, 0.15); border: 1px solid var(--color-success); color: var(--color-success); padding: 1rem; border-radius: 4px; margin-bottom: 1.5rem;">
              Thank you for contacting Caperino Furnitures & Interiors. We have received your inquiry and will respond promptly.
            </div>
          {%- elsif form.errors -%}
            <div style="background: rgba(142, 58, 43, 0.12); border: 1px solid var(--color-sale); color: var(--color-sale); padding: 1rem; border-radius: 4px; margin-bottom: 1.5rem; font-size: 0.9rem;">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div style="display: flex; flex-direction: column; gap: 1.25rem;">
            <div>
              <label for="ContactName" style="display: block; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; margin-bottom: 0.4rem;">
                Your Name <span style="color: var(--color-sale);">*</span>
              </label>
              <input
                type="text"
                id="ContactName"
                name="contact[name]"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                required
                style="width: 100%; padding: 0.85rem; border: 1px solid var(--color-border); border-radius: 2px;"
              >
            </div>

            <div>
              <label for="ContactEmail" style="display: block; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; margin-bottom: 0.4rem;">
                Email Address <span style="color: var(--color-sale);">*</span>
              </label>
              <input
                type="email"
                id="ContactEmail"
                name="contact[email]"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                required
                autocomplete="email"
                style="width: 100%; padding: 0.85rem; border: 1px solid var(--color-border); border-radius: 2px;"
              >
            </div>

            <div>
              <label for="ContactPhone" style="display: block; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; margin-bottom: 0.4rem;">
                Phone Number
              </label>
              <input
                type="tel"
                id="ContactPhone"
                name="contact[phone]"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                placeholder="+92 300 0000000"
                style="width: 100%; padding: 0.85rem; border: 1px solid var(--color-border); border-radius: 2px;"
              >
            </div>

            <div>
              <label for="ContactMessage" style="display: block; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; margin-bottom: 0.4rem;">
                Message / Inquired Items <span style="color: var(--color-sale);">*</span>
              </label>
              <textarea
                id="ContactMessage"
                name="contact[body]"
                rows="5"
                required
                placeholder="Tell us about the furniture or interior pieces you are interested in..."
                style="width: 100%; padding: 0.85rem; border: 1px solid var(--color-border); border-radius: 2px;"
              >{%- if form.body -%}{{ form.body }}{%- endif -%}</textarea>
            </div>

            <button type="submit" class="btn btn-primary" style="padding: 1rem 2rem;">
              Send Message
            </button>
          </div>
        {% endform %}
      </div>
    </div>
  </div>
</section>

<style>
  @media (min-width: 860px) {
    .contact-grid-wrap {
      grid-template-columns: 0.9fr 1.1fr !important;
    }
  }
</style>

{% schema %}
{
  "name": "Contact Page",
  "settings": []
}
{% endschema %}
