{%- comment -%}
  Quick View Modal Overlay
{%- endcomment -%}

<div class="quickview-modal" role="dialog" aria-modal="true" aria-label="Product Quick View" style="position: fixed; inset: 0; background: rgba(27,24,21,0.65); z-index: 1000; opacity: 0; visibility: hidden; transition: all 0.3s ease; display: flex; align-items: center; justify-content: center; padding: 1.5rem; backdrop-filter: blur(4px);">
  <div class="quickview-modal-content" style="background: #FFFFFF; border-radius: 4px; width: 100%; max-width: 840px; max-height: 90vh; overflow-y: auto; padding: 2rem; position: relative; box-shadow: 0 20px 50px rgba(0,0,0,0.15);">
    <button type="button" class="quickview-modal-close" style="position: absolute; top: 1.25rem; right: 1.25rem; background: none; border: none; cursor: pointer; color: var(--color-text-main); padding: 0.25rem;" aria-label="Close modal">
      <svg style="width: 24px; height: 24px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <div class="quickview-modal-body">
      <!-- Injected dynamically via assets/quick-view.js -->
    </div>
  </div>
</div>
